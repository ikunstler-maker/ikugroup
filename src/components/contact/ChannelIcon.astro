---
interface Props {
  name: 'whatsapp' | 'telegram' | 'email' | 'phone' | 'linkedin' | 'instagram';
  class?: string;
}
const { name, class: className = 'size-5' } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {
    name === 'whatsapp' && (
      <>
        <path d="M3.5 20.5 4.8 16.6A8.5 8.5 0 1 1 8 19.4Z" />
        <path d="M9 8.5c0 3.2 3.3 6.5 6.5 6.5l1-1.6-2-1-1 .9c-1-.4-2-1.4-2.4-2.4l.9-1-1-2Z" />
      </>
    )
  }
  {name === 'telegram' && <path d="M21 4 3 11l6.5 2.2M21 4l-3 16-8.5-6.8M21 4 9.5 13.2V19l3-3.2" />}
  {
    name === 'email' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2.5" />
        <path d="m3.5 6.5 8.5 6.5 8.5-6.5" />
      </>
    )
  }
  {name === 'phone' && <path d="M5 3.5h3.5l1.5 4.5-2.2 1.3a11 11 0 0 0 5 5L14 12l4.5 1.5V17A2.5 2.5 0 0 1 16 19.5 13.5 13.5 0 0 1 2.5 6 2.5 2.5 0 0 1 5 3.5Z" />}
  {
    name === 'linkedin' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="3" />
        <path d="M7.5 10.5v6M7.5 7.5v.01M11.5 16.5v-6M11.5 13a2.5 2.5 0 0 1 5 0v3.5" />
      </>
    )
  }
  {
    name === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <path d="M17.5 6.5v.01" />
      </>
    )
  }
</svg>

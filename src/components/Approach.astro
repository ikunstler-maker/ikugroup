---
import SectionHeader from './SectionHeader.astro';
import { approach as a } from '../data/content';
---

<section id="approach" class="section border-t border-line" aria-labelledby="approach-title">
  <div class="container-x">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Manifesto -->
      <div class="lg:col-span-6">
        <SectionHeader id="approach-title" tag={a.tag} title={a.title} />
        <div class="mt-8 space-y-5 text-[1.0625rem] leading-relaxed text-fg-muted md:text-lg" data-reveal>
          {a.manifesto.map((p) => <p set:html={p.replace('Agency-of-One & Custom Production', '<strong class="font-semibold text-fg">Agency-of-One &amp; Custom Production</strong>')} />)}
        </div>
        <button type="button" class="btn btn-ghost mt-10" data-open-booking data-objective="advisory">
          {a.cta}
          <svg class="arrow size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
        </button>
      </div>

      <!-- Comparison -->
      <div class="lg:col-span-6 lg:pt-14" data-reveal style="--reveal-delay:120ms">
        <div class="card overflow-hidden">
          <table class="w-full table-fixed border-collapse text-left">
            <caption class="sr-only">Classic production compared with the Agency-of-One model</caption>
            <thead>
              <tr class="border-b border-line">
                <th scope="col" class="px-5 py-4 text-tag font-medium text-fg-subtle md:px-6">Classic production</th>
                <th scope="col" class="border-l border-line bg-brand/[0.06] px-5 py-4 text-tag font-medium text-brand md:px-6">
                  Agency-of-One
                </th>
              </tr>
            </thead>
            <tbody>
              {
                a.comparison.map((row, i) => (
                  <tr class:list={[i > 0 && 'border-t border-line']}>
                    <td class="px-5 py-4 align-top md:px-6 md:py-5">
                      <span class="block text-tag text-fg-subtle">{row.aspect}</span>
                      <span class="mt-1.5 block text-sm leading-snug text-fg-muted line-through decoration-fg-subtle/50 md:text-[0.9375rem]">
                        {row.classic}
                      </span>
                    </td>
                    <td class="border-l border-line bg-brand/[0.03] px-5 py-4 align-top md:px-6 md:py-5">
                      <span class="block text-tag text-fg-subtle" aria-hidden="true">{row.aspect}</span>
                      <span class="mt-1.5 block text-sm leading-snug text-fg md:text-[0.9375rem]">{row.model}</span>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Principles -->
    <ol class="mt-16 grid gap-4 md:mt-24 md:grid-cols-3 md:gap-5">
      {
        a.principles.map((p, i) => (
          <li class="card flex flex-col p-6 md:p-8" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <span class="font-mono text-sm text-brand">{p.n}</span>
            <h3 class="mt-10 text-h3 md:mt-16">{p.title}</h3>
            <p class="mt-3 leading-relaxed text-fg-muted">{p.copy}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

---
import SectionHeader from './SectionHeader.astro';
import { trackRecord as t } from '../data/content';

const allClients = t.categories.flatMap((c) => c.clients);
---

<section id="track-record" class="section border-t border-line" aria-labelledby="track-record-title">
  <div class="container-x">
    <SectionHeader id="track-record-title" tag={t.tag} title={t.title} sub={t.sub} />
  </div>

  <!-- Marquee -->
  <div class="group/marquee relative mt-14 overflow-hidden border-y border-line py-6 md:mt-20 md:py-8" aria-hidden="true">
    <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-16 bg-gradient-to-r from-bg to-transparent md:w-40"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-16 bg-gradient-to-l from-bg to-transparent md:w-40"></div>
    <div class="flex w-max animate-marquee group-hover/marquee:[animation-play-state:paused]">
      {
        [0, 1].map(() => (
          <ul class="flex shrink-0 items-center">
            {allClients.map((name) => (
              <li class="flex items-center">
                <span class="px-6 text-2xl font-semibold tracking-tight whitespace-nowrap text-fg/80 md:px-10 md:text-[2rem]">
                  {name}
                </span>
                <span class="size-1.5 rotate-45 bg-brand/50" />
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  <div class="container-x">
    <!-- Clients by industry -->
    <dl class="mt-14 border-b border-line md:mt-20">
      {
        t.categories.map((c, i) => (
          <div
            class="grid gap-3 border-t border-line py-6 md:grid-cols-12 md:gap-8 md:py-7"
            data-reveal
            style={`--reveal-delay:${i * 60}ms`}
          >
            <dt class="text-tag text-fg-muted md:col-span-4 md:pt-1.5">{c.name}</dt>
            <dd class="md:col-span-8">
              <ul class="flex flex-wrap gap-x-2 gap-y-1 text-lg leading-snug md:text-xl">
                {c.clients.map((name, j) => (
                  <li class="text-fg">
                    {name}
                    {j < c.clients.length - 1 && <span class="ml-2 text-fg-subtle">·</span>}
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>

    <!-- NDA counter card -->
    <div class="card mt-10 overflow-hidden p-6 md:mt-14 md:p-10" data-reveal>
      <div class="grid gap-8 md:grid-cols-12 md:items-center">
        <div class="flex items-center gap-5 md:col-span-4">
          <span class="grid size-14 shrink-0 place-items-center rounded-2xl border border-line-strong bg-surface-2 text-brand">
            <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="4.5" y="10.5" width="15" height="10" rx="2.5" />
              <path d="M8 10.5V7.5a4 4 0 0 1 8 0v3" />
              <circle cx="12" cy="15.5" r="1.25" fill="currentColor" stroke="none" />
            </svg>
          </span>
          <span class="text-6xl font-semibold tracking-tighter md:text-7xl">{t.nda.count}</span>
        </div>
        <div class="md:col-span-8">
          <h3 class="text-h3">{t.nda.title}</h3>
          <p class="mt-3 leading-relaxed text-fg-muted">{t.nda.copy}</p>
          <div class="mt-6 grid gap-1.5 font-mono text-[0.6875rem] tracking-wider text-fg-subtle uppercase" aria-hidden="true">
            <p>Client: <span class="inline-block h-2.5 w-24 translate-y-px rounded-sm bg-fg/15 align-middle"></span> · Scope: Generative workflow · Delivered</p>
            <p>Client: <span class="inline-block h-2.5 w-16 translate-y-px rounded-sm bg-fg/15 align-middle"></span> · Scope: Internal tooling · Delivered</p>
            <p class="hidden sm:block">Client: <span class="inline-block h-2.5 w-28 translate-y-px rounded-sm bg-fg/15 align-middle"></span> · Scope: White-label production · Delivered</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

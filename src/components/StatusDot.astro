---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class:list={['relative inline-flex size-2 shrink-0', className]} aria-hidden="true">
  <span class="absolute inset-0 rounded-full bg-live motion-safe:animate-pulse-dot"></span>
  <span class="relative inline-flex size-2 rounded-full bg-live"></span>
</span>

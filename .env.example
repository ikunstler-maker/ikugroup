# Copy to `.env` (local) or set in your hosting dashboard (Vercel / Netlify / Cloudflare Pages).
#
# Form delivery endpoint for the call-request form.
# Works with any service that accepts a JSON POST, e.g.:
#   Web3Forms  → https://api.web3forms.com/submit   (also set PUBLIC_FORM_ACCESS_KEY)
#   Formspree  → https://formspree.io/f/xxxxxxxx
# If left empty, the form still works: it assembles the request and lets the
# visitor send it via WhatsApp, Telegram or e-mail in one tap.
PUBLIC_FORM_ENDPOINT=

# Web3Forms access key (public by design — safe to ship in client code).
PUBLIC_FORM_ACCESS_KEY=
